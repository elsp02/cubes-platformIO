{
  head: {
    text: "Single-wire parent-child communication"
  },
  signal: [
    {name: "1-wire", wave: "1.010...1.01...0..1...0.1...010..1..."},
    {name: "Transmitter?", wave: "x.7.........8..5.........8..5......x.", data: ["CMD_STATUS", "delay", "ACK_BUSY", "delay","DATA_FRAME [length varies]"]}
  ],
  foot:{"text": "green: parent cube as transmitter; blue: child cube as transmitter "},
  "config": {"hscale": 0.5}
}