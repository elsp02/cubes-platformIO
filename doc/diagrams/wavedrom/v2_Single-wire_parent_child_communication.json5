{
  head: {
    text: "Single-wire parent-child communication"
  },
  signal: [
    {name: "Parent", wave: "x.7.........0......................x.", data: ["CMD_STATUS", "delay", "ACK_BUSY", "delay","DATA_FRAME [length varies]"]},
    {name: "1-wire", wave: "1.010...1.01...0..1...0.1...010..1..."},
    {name: "Child", wave: "x.0.........8..5.........8..6......x.", data: ["delay", "ACK_BUSY", "delay?","DATA_FRAME [length varies]"]},
  ],
  foot:{"text": ""},
  "config": {"hscale": 0.5}
}